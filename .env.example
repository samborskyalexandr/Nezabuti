# Copy to .env and fill in secrets before starting.

# MongoDB
MONGO_DATABASE=nezabuti

# JWT (min 32 characters)
JWT_SECRET=change-me-to-a-long-random-secret-value
JWT_ISSUER=nezabuti
JWT_AUDIENCE=nezabuti-admin

# Bootstrap admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Public site URL (used for QR + SEO canonical)
PUBLIC_BASE_URL=http://localhost:8088

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8088

# Local frontend published port
FRONTEND_HOST_PORT=8088

# Image processing
IMAGE_MAX_UPLOAD_BYTES=26214400
IMAGE_THUMB_MAX_DIMENSION=320
IMAGE_PREVIEW_MAX_DIMENSION=800
IMAGE_FULL_MAX_DIMENSION=2000
IMAGE_WEBP_QUALITY=80

# ASP.NET environment
ASPNETCORE_ENVIRONMENT=Development
